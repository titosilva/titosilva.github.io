							<rect x="21" y="27" width="1" height="1" /><rect x="23" y="27" width="1" height="1" /><rect x="25" y="27" width="1" height="1" />
							<rect x="27" y="27" width="1" height="1" /><rect x="29" y="27" width="1" height="1" /><rect x="31" y="27" width="1" height="1" />
							<rect x="33" y="27" width="1" height="1" /><rect x="35" y="27" width="1" height="1" /><rect x="37" y="27" width="1" height="1" />
							<rect x="41" y="27" width="1" height="1" /><rect x="41" y="25" width="1" height="1" /><rect x="43" y="23" width="1" height="1" />
