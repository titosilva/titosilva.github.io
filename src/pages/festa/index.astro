				<b>PLAYER 2?</b>
				TE ESPERO LÁ PARA JOGAR!
			</footer>
		</main>

		<script is:inline define:vars={{ EVENT }}>
			const $ = (id) => document.getElementById(id);
			const start = new Date(EVENT.start).getTime();
			const end = new Date(EVENT.end).getTime();
			const DAY = 864e5;

			// Contagem regressiva como barra de vida: enche nos últimos 30 dias.
			function tick() {
				const now = Date.now();
				const left = start - now;
				let big, label, pct;
				if (now >= end) {
					big = "GAME OVER"; label = "OBRIGADO POR JOGAR!"; pct = 100;
				} else if (now >= start) {
					big = "EM JOGO!"; label = "A FESTA ESTÁ ROLANDO"; pct = 100;
				} else if (left < DAY && new Date(now).toDateString() === new Date(start).toDateString()) {
					const h = Math.floor(left / 36e5), m = Math.floor((left % 36e5) / 6e4);
					big = "É HOJE!"; label = `FALTAM ${h}H ${String(m).padStart(2, "0")}MIN`; pct = 98;
				} else {
					const midnight = (t) => { const x = new Date(t); x.setHours(0, 0, 0, 0); return x.getTime(); };
					const d = Math.round((midnight(start) - midnight(now)) / DAY);
					big = `${d} ${d === 1 ? "DIA" : "DIAS"}`; label = "PARA A PARTIDA COMEÇAR";
					pct = Math.max(4, Math.min(96, 100 - (left / (30 * DAY)) * 100));
				}
				$("count").textContent = big;
				$("count-label").textContent = label;
				$("fill").style.width = pct + "%";
			}
			tick();
			setInterval(tick, 30000);

			// Som 8-bit curtinho no START.
			function chime() {
				try {
					const ctx = new (window.AudioContext || window.webkitAudioContext)();
					[523.25, 659.25, 783.99, 1046.5].forEach((f, i) => {
						const o = ctx.createOscillator(), g = ctx.createGain();
						o.type = "square"; o.frequency.value = f;
						g.gain.value = 0.04;
						o.connect(g); g.connect(ctx.destination);
						const t = ctx.currentTime + i * 0.09;
						o.start(t); o.stop(t + 0.08);
					});
				} catch (e) {}
			}

			$("start").addEventListener("click", () => {
				chime();
				const card = $("fase1");
				card.scrollIntoView({ behavior: "smooth", block: "start" });
				card.classList.remove("flash");
				void card.offsetWidth;
				card.classList.add("flash");
			});

			$("copy").addEventListener("click", async (ev) => {
				const addr = ev.currentTarget.dataset.addr;
				const note = $("copy-note");
				try {
					await navigator.clipboard.writeText(addr);
					note.textContent = "ENDEREÇO COPIADO ✓";
				} catch (e) {
					note.textContent = addr;
				}
			});

			$("ics").addEventListener("click", () => {
				const ics = [
					"BEGIN:VCALENDAR",
					"VERSION:2.0",
					"PRODID:-//titosilva.github.io//festa//PT",
					"BEGIN:VEVENT",
					"UID:titos-party-2026@titosilva.github.io",
					"DTSTAMP:" + new Date().toISOString().replace(/[-:]/g, "").split(".")[0] + "Z",
					"DTSTART:20261017T220000Z",
					"DTEND:20261018T030000Z",
					"SUMMARY:Tito's Party - 25 anos",
					"DESCRIPTION:Noite de jogos!",
					"LOCATION:" + EVENT.fullAddress.replace(/,/g, "\\,"),
					"GEO:" + EVENT.lat + ";" + EVENT.lon,
					"END:VEVENT",
					"END:VCALENDAR",
				].join("\r\n");
				const url = URL.createObjectURL(new Blob([ics], { type: "text/calendar" }));
				const a = document.createElement("a");
				a.href = url; a.download = "titos-party.ics";
				document.body.appendChild(a); a.click(); a.remove();
				setTimeout(() => URL.revokeObjectURL(url), 1000);
			});
		</script>
	</body>
</html>
