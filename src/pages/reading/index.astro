---
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";
import { tagTranslations } from "../../i18n/translations";

const books = (await getCollection("books")).sort((a, b) => {
  if (a.data.pinned !== b.data.pinned) {
    return a.data.pinned ? -1 : 1;
  }

  return new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime();
});

const cardData = books.map((book) => ({
  url: book.data.hasPage ? `/reading/${book.id}` : null,
  title: book.data.title,
  authors: book.data.authors,
  tags: book.data.tags || [],
}));
---

<Layout title="Reading">
    {cardData.length === 0 && (
        <div class="flex flex-col items-center justify-center py-20">
            <span class="text-2xl text-gray-400" data-i18n="reading.empty">No books found.</span>
        </div>
    )}

    {
        cardData.length > 0 && (
            <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-4 p-5 max-w-300 mx-auto">
            {
                cardData.map((book) => (
                    <div class="flex flex-col aspect-square border-2 border-primary-light rounded-md p-3">
                        <span class="text-base font-semibold text-primary-light flex-1">
                            {book.title}
                        </span>

                        <span class="text-xs text-gray-400 mt-2">
                            {book.authors.join(", ")}
                        </span>

                        {book.tags.length > 0 && (
                            <div class="flex flex-wrap gap-1 mt-2">
                                {book.tags.map((tag) => (
                                    <span
                                        class="text-[0.65rem] px-1.5 py-0.5 border border-primary-light rounded-md"
                                        data-i18n-en={tagTranslations[tag] || tag}
                                        data-i18n-pt-br={tag}
                                    >
                                        {tag}
                                    </span>
                                ))}
                            </div>
                        )}

                        {book.url && (
                            <a href={book.url} class="text-xs text-primary-light hover:underline underline-offset-4 mt-2" data-i18n="reading.myNotes">
                                My notes >>
                            </a>
                        )}
                    </div>
                ))
            }
            </div>
        )
    }
</Layout>
