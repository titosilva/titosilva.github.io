---
import '../styles/global.css';
import { SquareMenu, CircleX, ChevronDown } from '@lucide/astro';

interface Props {
	title?: string;
	og?: {
		title?: string;
		description?: string;
		image?: string;
	};
}

const { title = "Tito Silva", og = {} } = Astro.props as Props;
const renderDate = new Date().toISOString();

// Single source of truth for the "others" dropdown/accordion contents.
// Add more entries here later - both desktop and mobile menus render from this list.
const otherLinks = [
	{ label: "game", href: "/jogo" },
	{ label: "poetry", href: "/poetry" },
	{ label: "reading", href: "/reading" },
];
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>

		<meta property="og:site_name" content="Tito Silva's Blog" />
		<meta property="og:title" content={og.title || 'Tito Silva\'s Blog - A place for sharing knowledge'} />
		<meta property="og:description" content={og.description || 'Hi! Welcome to my personal blog, where I share my thoughts and projects. Let\'s build something amazing together!'} />
		<meta property="og:image" content={og.image || 'https://titosilva.github.io/og-default.png'} />
		<meta property="og:image:secure_url" content={og.image || 'https://titosilva.github.io/og-default.png'} />
		<meta property="og:image:type" content="image/png" />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:type" content="website" />
		<meta property="og:url" content="https://titosilva.github.io" />
		<meta property="og:updated_time" content={renderDate} />

		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Vend+Sans:ital,wght@0,300..700;1,300..700&display=swap" rel="stylesheet">
		<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.13.0/dist/katex.min.css">
	</head>
	<body class="flex flex-col bg-primary-darkest">
		<div class="flex justify-between p-5 max-w-300 mx-auto w-full">
			<a class="flex md:hidden justify-center items-center text-3xl bg-primary-light text-primary-darkest rounded-md aspect-square p-1" href="/">
				<span>TS</span>
			</a>

			<a class="hidden md:flex text-4xl text-primary-light" href="/">
				<div class="hidden md:flex justify-center items-center text-3xl bg-primary-light text-primary-darkest rounded-md aspect-square p-1">
					<span>TS</span>
				</div>
				<span class="mx-3">
					|
				</span>
				BLOG
			</a>


			<div class="hidden md:flex flex-row gap-5 items-center mx-8">
				<a class="text-xl hover:underline underline-offset-8 hover:text-primary-light" href="/about-me">
					/about-me
				</a>

				<a class="text-xl hover:underline underline-offset-8 hover:text-primary-light" href="/posts">
					/posts
				</a>

				<a class="text-xl hover:underline underline-offset-8 hover:text-primary-light" href="/projects">
					/projects
				</a>

				<div class="relative flex items-center">
					<button
						id="othersBtn"
						type="button"
						class="flex items-center gap-1 text-xl hover:underline underline-offset-8 hover:text-primary-light cursor-pointer"
						aria-haspopup="true"
						aria-expanded="false"
					>
						/others
						<ChevronDown size="1em" />
					</button>

					<div
						id="othersPanel"
						class="hidden flex-col absolute top-full left-0 mt-2 min-w-40 bg-primary-darkest border-2 border-primary-light rounded-md py-2 z-50"
					>
						{otherLinks.map((link) => (
							<a
								href={link.href}
								class="px-4 py-2 text-lg whitespace-nowrap hover:underline underline-offset-4 hover:text-primary-light"
							>
								/{link.label}
							</a>
						))}
					</div>
				</div>

				<div class="relative flex items-center">
					<button
						id="langBtn"
						type="button"
						class="flex items-center gap-1 text-xl hover:underline underline-offset-8 hover:text-primary-light cursor-pointer"
						aria-haspopup="true"
						aria-expanded="false"
						aria-label="Change language"
					>
						<span id="langBtnLabel">lang:en</span>
						<ChevronDown size="1em" />
					</button>

					<div
						id="langPanel"
						class="hidden flex-col absolute top-full left-0 mt-2 min-w-36 bg-primary-darkest border-2 border-primary-light rounded-md py-2 z-50"
					>
						<button
							type="button"
							class="lang-option flex items-center gap-2 px-4 py-2 text-lg whitespace-nowrap hover:underline underline-offset-4 hover:text-primary-light w-full text-left cursor-pointer"
							data-lang="en"
						>
							lang:en
						</button>
						<button
							type="button"
							class="lang-option flex items-center gap-2 px-4 py-2 text-lg whitespace-nowrap hover:underline underline-offset-4 hover:text-primary-light w-full text-left cursor-pointer"
							data-lang="pt-br"
						>
							lang:pt-br
						</button>
					</div>
				</div>
			</div>

			<a id="menuBtn" class="flex md:hidden items-center justify-center text-3xl">
				<SquareMenu size="1lh" />
			</a>
		</div>

		<div id="menu" class="absolute w-full h-full bg-primary-darkest hidden flex-col items-center justify-center z-50 gap-5">
			<a id="closeBtn" class="text-4xl hover:underline underline-offset-8 hover:text-primary-light mb-8">
				<CircleX size="1lh" />
			</a>

			<a class="text-xl hover:underline underline-offset-8 hover:text-primary-light" href="/about-me">
				/about-me
			</a>

			<a class="text-xl hover:underline underline-offset-8 hover:text-primary-light" href="/posts">
				/posts
			</a>

			<a class="text-xl hover:underline underline-offset-8 hover:text-primary-light" href="/projects">
				/projects
			</a>

			<div class="flex flex-col items-center">
				<button
					id="othersMobileBtn"
					type="button"
					class="flex items-center gap-1 text-xl hover:underline underline-offset-8 hover:text-primary-light cursor-pointer"
					aria-expanded="false"
				>
					/others
					<ChevronDown size="1em" />
				</button>

				<div id="othersMobilePanel" class="hidden flex-col items-center gap-3 mt-3">
					{otherLinks.map((link) => (
						<a
							href={link.href}
							class="text-lg pl-4 hover:underline underline-offset-8 hover:text-primary-light"
						>
							/{link.label}
						</a>
					))}
				</div>
			</div>

			<div class="flex flex-col items-center mt-3">
				<button
					id="langMobileBtn"
					type="button"
					class="flex items-center gap-1 text-xl hover:underline underline-offset-8 hover:text-primary-light cursor-pointer"
					aria-expanded="false"
					aria-label="Change language"
				>
					<span id="langMobileBtnLabel">lang:en</span>
					<ChevronDown size="1em" />
				</button>

				<div id="langMobilePanel" class="hidden flex-col items-center gap-3 mt-3">
					<button type="button" class="lang-option text-lg pl-4 hover:underline underline-offset-8 hover:text-primary-light cursor-pointer" data-lang="en">
						lang:en
					</button>
					<button type="button" class="lang-option text-lg pl-4 hover:underline underline-offset-8 hover:text-primary-light cursor-pointer" data-lang="pt-br">
						lang:pt-br
					</button>
				</div>
			</div>
		</div>

		<slot />
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}
</style>

<script>
	import { getCurrentLocale, applyTranslations, setLocale, LOCALE_CHANGE_EVENT, type Locale } from "../i18n/client";

	const labelFor = (locale: Locale) => (locale === "pt-br" ? "lang:pt-br" : "lang:en");

	const displayMenu = () => {
		const elem = document.getElementById("menu");

		if (!elem) {
			return;
		}

		elem.classList.replace("hidden", "flex");
	}

	// --- Mobile "others" accordion (inline, inside #menu overlay) ---
	const othersMobileBtn = document.getElementById("othersMobileBtn");
	const othersMobilePanel = document.getElementById("othersMobilePanel");

	const hideOthersMobilePanel = () => {
		if (!othersMobilePanel || othersMobileBtn?.getAttribute("aria-expanded") !== "true") {
			return;
		}

		othersMobilePanel.classList.replace("flex", "hidden");
		othersMobileBtn?.setAttribute("aria-expanded", "false");
	}

	othersMobileBtn?.addEventListener("click", () => {
		const isHidden = othersMobilePanel?.classList.contains("hidden");

		if (isHidden) {
			othersMobilePanel?.classList.replace("hidden", "flex");
			othersMobileBtn.setAttribute("aria-expanded", "true");
		} else {
			hideOthersMobilePanel();
		}
	});

	// --- Mobile "language" accordion (inline, inside #menu overlay) ---
	const langMobileBtn = document.getElementById("langMobileBtn");
	const langMobilePanel = document.getElementById("langMobilePanel");
	const langMobileBtnLabel = document.getElementById("langMobileBtnLabel");

	const hideLangMobilePanel = () => {
		if (!langMobilePanel || langMobileBtn?.getAttribute("aria-expanded") !== "true") {
			return;
		}

		langMobilePanel.classList.replace("flex", "hidden");
		langMobileBtn?.setAttribute("aria-expanded", "false");
	}

	langMobileBtn?.addEventListener("click", () => {
		const isHidden = langMobilePanel?.classList.contains("hidden");

		if (isHidden) {
			langMobilePanel?.classList.replace("hidden", "flex");
			langMobileBtn.setAttribute("aria-expanded", "true");
		} else {
			hideLangMobilePanel();
		}
	});

	const hideMenu = () => {
		const elem = document.getElementById("menu");

		if (!elem) {
			return;
		}

		elem.classList.replace("flex", "hidden");

		// Collapse the mobile "others" and "language" accordions so they
		// don't stay expanded the next time the menu is reopened.
		hideOthersMobilePanel();
		hideLangMobilePanel();
	}

	hideMenu();
	const btn = document.getElementById("menuBtn");
	btn?.addEventListener("click", () => {
		displayMenu();
	});

	const closeBtn = document.getElementById("closeBtn");
	closeBtn?.addEventListener("click", () => {
		hideMenu();
	});

	// --- Desktop "others" dropdown ---
	const othersBtn = document.getElementById("othersBtn");
	const othersPanel = document.getElementById("othersPanel");

	const hideOthersPanel = () => {
		if (!othersPanel || othersBtn?.getAttribute("aria-expanded") !== "true") {
			return;
		}

		othersPanel.classList.replace("flex", "hidden");
		othersBtn?.setAttribute("aria-expanded", "false");
	}

	othersBtn?.addEventListener("click", (event) => {
		event.stopPropagation();
		const isHidden = othersPanel?.classList.contains("hidden");

		if (isHidden) {
			othersPanel?.classList.replace("hidden", "flex");
			othersBtn.setAttribute("aria-expanded", "true");
		} else {
			hideOthersPanel();
		}
	});

	document.addEventListener("click", (event) => {
		if (!othersPanel || othersPanel.classList.contains("hidden")) {
			return;
		}

		if (othersBtn?.contains(event.target as Node) || othersPanel.contains(event.target as Node)) {
			return;
		}

		hideOthersPanel();
	});

	// --- Desktop "language" dropdown ---
	const langBtn = document.getElementById("langBtn");
	const langPanel = document.getElementById("langPanel");
	const langBtnLabel = document.getElementById("langBtnLabel");

	const hideLangPanel = () => {
		if (!langPanel || langBtn?.getAttribute("aria-expanded") !== "true") {
			return;
		}

		langPanel.classList.replace("flex", "hidden");
		langBtn?.setAttribute("aria-expanded", "false");
	}

	langBtn?.addEventListener("click", (event) => {
		event.stopPropagation();
		const isHidden = langPanel?.classList.contains("hidden");

		if (isHidden) {
			langPanel?.classList.replace("hidden", "flex");
			langBtn.setAttribute("aria-expanded", "true");
		} else {
			hideLangPanel();
		}
	});

	document.addEventListener("click", (event) => {
		if (!langPanel || langPanel.classList.contains("hidden")) {
			return;
		}

		if (langBtn?.contains(event.target as Node) || langPanel.contains(event.target as Node)) {
			return;
		}

		hideLangPanel();
	});

	// --- Language selection (shared between desktop and mobile triggers) ---
	const updateLangLabels = (locale: Locale) => {
		const label = labelFor(locale);
		if (langBtnLabel) langBtnLabel.textContent = label;
		if (langMobileBtnLabel) langMobileBtnLabel.textContent = label;
	}

	document.querySelectorAll<HTMLButtonElement>(".lang-option").forEach((option) => {
		option.addEventListener("click", () => {
			const locale = option.dataset.lang === "pt-br" ? "pt-br" : "en";
			setLocale(locale);
			updateLangLabels(locale);
			hideLangPanel();
			hideLangMobilePanel();
		});
	});

	const initialLocale = getCurrentLocale();
	applyTranslations(initialLocale);
	updateLangLabels(initialLocale);

	window.addEventListener(LOCALE_CHANGE_EVENT, () => {
		hideLangPanel();
		hideLangMobilePanel();
	});
</script>
